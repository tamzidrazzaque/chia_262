+;; Generated by rtl-model/boomhw from BOOM v3 / rocket-chip Scala sources
+;; (MegaBoomV3Config). Latency = issue -> dependent issue (cycles).
+;; Do not edit by hand; regenerate with: python3 -m boomhw.cli
+;; Port map: int0=ALU+JMP+I2F; int1=ALU+CSR; int2=ALU+IMUL; int3=ALU+IDIV
+;; idiv policy: full_width_div10 (operand-dependent on hardware, see hw model)
+
+(define_automaton "boom_int,boom_mem,boom_fp,boom_idiv_auto,boom_fdiv_auto")
+(define_cpu_unit "boom_int0" "boom_int")
+(define_cpu_unit "boom_int1" "boom_int")
+(define_cpu_unit "boom_int2" "boom_int")
+(define_cpu_unit "boom_int3" "boom_int")
+(define_cpu_unit "boom_mem0" "boom_mem")
+(define_cpu_unit "boom_mem1" "boom_mem")
+(define_cpu_unit "boom_fp0" "boom_fp")
+(define_cpu_unit "boom_fp1" "boom_fp")
+(define_cpu_unit "boom_idiv" "boom_idiv_auto")
+(define_cpu_unit "boom_fdiv" "boom_fdiv_auto")
+
+;; any of the 4 integer ALUs; fast wakeup
+(define_insn_reservation "boom_alu" 1
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "unknown,const,arith,logical,shift,slt,move,nop,multi,sfb_alu,bitmanip,rotate,min,max,minu,maxu,clz,ctz,cpop,condmove,zicond,mvpair,clmul,crypto"))
+  "(boom_int0|boom_int1|boom_int2|boom_int3)")
+
+;; conditional branches are FU_ALU and resolve on any ALU
+(define_insn_reservation "boom_branch" 1
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "branch"))
+  "(boom_int0|boom_int1|boom_int2|boom_int3)")
+
+;; FU_JMP (jal/jalr/auipc) only on int0; not bypassable -> slow wakeup
+(define_insn_reservation "boom_jump" 4
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "jump,jalr,ret,call,auipc"))
+  "boom_int0")
+
+;; CSR unit on int1 (serializing); latency estimate
+(define_insn_reservation "boom_csr" 4
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "rdfrm,wrfrm,wrvxrm,rdvlenb,rdvl,trap,vsetvl,vsetvl_pre"))
+  "boom_int1")
+
+;; pipelined multiplier (imulLatency=3) on int2, one per cycle; incl. mulh/mulhu
+(define_insn_reservation "boom_imul" 6
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "imul"))
+  "boom_int2")
+
+;; iterative MulDiv on int3; only the issue slot of int3 is taken, its ALU stays free
+(define_insn_reservation "boom_idiv_si" 34
+  (and (eq_attr "tune" "boom")
+       (and (eq_attr "type" "idiv") (eq_attr "mode" "SI")))
+  "boom_int3+boom_idiv,boom_idiv*33")
+
+(define_insn_reservation "boom_idiv_di" 67
+  (and (eq_attr "tune" "boom")
+       (and (eq_attr "type" "idiv") (eq_attr "mode" "DI")))
+  "boom_int3+boom_idiv,boom_idiv*66")
+
+;; L1 hit, speculative wakeup from s1
+(define_insn_reservation "boom_load" 4
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "load"))
+  "(boom_mem0|boom_mem1)")
+
+;; FP loads: no speculative wakeup
+(define_insn_reservation "boom_fpload" 5
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "fpload"))
+  "(boom_mem0|boom_mem1)")
+
+(define_insn_reservation "boom_store" 1
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "store"))
+  "(boom_mem0|boom_mem1)")
+
+;; FP store data goes through the FPIU on fp0
+(define_insn_reservation "boom_fpstore" 1
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "fpstore"))
+  "(boom_mem0|boom_mem1)+boom_fp0")
+
+;; latency estimate
+(define_insn_reservation "boom_atomic" 4
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "atomic"))
