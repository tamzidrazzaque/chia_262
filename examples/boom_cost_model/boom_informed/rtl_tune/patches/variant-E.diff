+(define_insn_reservation "boom_fp" 7
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "fadd,fmul,fmadd,fmove,fcvt"))
+  "(boom_fp0|boom_fp1)")
+
+;; FP->int (FPIU) only on fp0; latency estimate
+(define_insn_reservation "boom_f2i" 8
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "mfc,fcmp,fcvt_f2i"))
+  "boom_fp0")
+
+;; int->FP (IFPU) on integer port int0; latency estimate
+(define_insn_reservation "boom_i2f" 6
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "mtc,fcvt_i2f"))
+  "boom_int0")
+
+;; hardfloat DivSqrtRecF64 on fp0, one op at a time
+(define_insn_reservation "boom_fdiv" 23
+  (and (eq_attr "tune" "boom")
+       (eq_attr "type" "fdiv"))
+  "boom_fp0+boom_fdiv,boom_fdiv*18")
+
+(define_insn_reservation "boom_fsqrt" 31
+  (and (eq_attr "tune" "boom")
