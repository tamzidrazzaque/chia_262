{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saturn SPEC immutable bundle v1",
  "description": "manifest.json, authenticated by an externally supplied SHA-256. Referenced metadata schemas are in $defs. The Python verifier adds hash, ELF, cross-file, role, validation-log and filesystem checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "argv",
    "benchmark",
    "candidate_id",
    "compiler_manifest",
    "executable",
    "expected_outputs",
    "files_sha256",
    "input_id",
    "inputs",
    "isa_metadata",
    "role",
    "schema_version",
    "size",
    "source_variant",
    "stderr",
    "stdin",
    "stdout",
    "target",
    "validation_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "role": {
      "enum": [
        "1-scalar",
        "2-generic-vector",
        "3-saturn-aware"
      ]
    },
    "candidate_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{12,32}$"
        }
      ]
    },
    "benchmark": {
      "type": "string",
      "pattern": "^[56][0-9]{2}\\.[A-Za-z0-9_]+_[rs]$"
    },
    "input_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "size": {
      "enum": [
        "test",
        "train",
        "ref"
      ]
    },
    "source_variant": {
      "const": "unchanged SPEC CPU2017 source"
    },
    "target": {
      "const": {
        "agfi": "agfi-012e92467d7d2149a",
        "driver_sha256": "5d3353ea8e6bf2891555da3d7b29122b1143a2e3d8c61a2a55741f1fd0bc94bd",
        "quintuplet": "f2-firesim-FireSim-FireSimREFV256D128RocketConfig-WithAutoILA_FRFCFS16GBQuadRankLLC4MB_BaseF2Config",
        "vlen_bits": 256,
        "dlen_bits": 128
      }
    },
    "compiler_manifest": {
      "$ref": "#/$defs/path"
    },
    "isa_metadata": {
      "$ref": "#/$defs/path"
    },
    "validation_manifest": {
      "$ref": "#/$defs/path"
    },
    "executable": {
      "$ref": "#/$defs/path"
    },
    "stdout": {
      "$ref": "#/$defs/path"
    },
    "stderr": {
      "$ref": "#/$defs/path"
    },
    "inputs": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/path"
      }
    },
    "expected_outputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/path"
      },
      "description": "Work output path -> bundled producer-validated exact golden file; tolerance/specdiff comparators are not accepted by this lane."
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "prefixItems": [
        {
          "const": "./program"
        }
      ],
      "items": {
        "type": "string",
        "maxLength": 8192,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "stdin": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/path"
        }
      ]
    },
    "files_sha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/path"
          },
          {
            "not": {
              "const": "manifest.json"
            }
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "3-saturn-aware"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12,32}$"
          }
        }
      },
      "else": {
        "properties": {
          "candidate_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.+/-]+$",
      "minLength": 1,
      "maxLength": 512,
      "description": "Canonical relative POSIX file path, no empty/dot/dot-dot components, no links; semantic checks are mandatory."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_manifest": {
      "type": "object",
      "required": [
        "candidate_id",
        "compiler_sha256",
        "gcc_revision",
        "gcc_version",
        "role",
        "snapshot_id",
        "target_flags"
      ],
      "properties": {
        "gcc_version": {
          "const": "15.1.0"
        },
        "gcc_revision": {
          "const": "1b306039ac49f8ad91ca71d3de3150a3c9fa792a"
        },
        "role": {
          "enum": [
            "1-scalar",
            "2-generic-vector",
            "3-saturn-aware"
          ]
        },
        "compiler_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "target_flags": {
          "enum": [
            "-march=rv64gc -mabi=lp64d -mtune=rocket -fno-tree-loop-vectorize -fno-tree-slp-vectorize",
            "-march=rv64gcv_zvbb -mabi=lp64d -mtune=rocket -mrvv-vector-bits=zvl -fvect-cost-model=dynamic -fopt-info-vec-all"
          ]
        }
      }
    },
    "isa_metadata": {
      "type": "object",
      "required": [
        "abi",
        "dlen_bits",
        "elf_sha256",
        "linkage",
        "riscv_arch",
        "static_rvv_instruction_count",
        "vlen_bits"
      ],
      "properties": {
        "elf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "riscv_arch": {
          "type": "string",
          "pattern": "^rv64"
        },
        "abi": {
          "const": "lp64d"
        },
        "linkage": {
          "const": "static"
        },
        "vlen_bits": {
          "const": 256
        },
        "dlen_bits": {
          "const": 128
        },
        "static_rvv_instruction_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validation_manifest": {
      "type": "object",
      "required": [
        "backend",
        "benchmark",
        "compiler_manifest_sha256",
        "elf_sha256",
        "expected_outputs_sha256",
        "input_id",
        "inputs_sha256",
        "invocation_sha256",
        "isa_metadata_sha256",
        "role",
        "size",
        "source_variant",
        "spec_validation",
        "status",
        "target_dlen",
        "target_vlen",
        "validation_log"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "spec_validation": {
          "const": "passed"
        },
        "backend": {
          "const": "qemu"
        },
        "role": {
          "enum": [
            "1-scalar",
            "2-generic-vector",
            "3-saturn-aware"
          ]
        },
        "benchmark": {
          "type": "string",
          "pattern": "^[56][0-9]{2}\\.[A-Za-z0-9_]+_[rs]$"
        },
        "size": {
          "enum": [
            "test",
            "train",
            "ref"
          ]
        },
        "input_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "source_variant": {
          "const": "unchanged SPEC CPU2017 source"
        },
        "target_vlen": {
          "const": 256
        },
        "target_dlen": {
          "const": 128
        },
        "elf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "isa_metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputs_sha256": {
          "type": "object",
          "minProperties": 0,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "expected_outputs_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "validation_log": {
          "$ref": "#/$defs/path"
        },
        "invocation_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
